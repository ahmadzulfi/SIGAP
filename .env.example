# Salin file ini menjadi .env, lalu isi LANGFLOW_API_KEY.
# Buat key di Langflow: Settings → Langflow API Keys → Add New.

LANGFLOW_URL=http://127.0.0.1:7860
LANGFLOW_API_KEY=

# Koleksi Chroma berisi knowledge base Bandung Raya (lihat npm run ingest-kb)
KB_KOLEKSI=tanya_layanan_v10

# Alamat web Tanya Layanan
HOST=127.0.0.1
PORT=3000

# Kunci halaman petugas (/petugas.html). Kosongkan untuk membukanya hanya dari komputer ini.
PETUGAS_KUNCI=
